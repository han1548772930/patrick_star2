import { Button, ComboBox, LineEdit } from "std-widgets.slint";
import { Win32TitleBar } from "@slint-borderless/titlebar.slint";

export component SettingsWindow inherits Window {
    title: "Patrick Star 设置";
    preferred-width: 520px;
    preferred-height: 344px;
    min-width: 440px;
    min-height: 320px;
    background: #f7f8fa;
    default-font-size: 14px;

    in property <int> caption-hover: 0;
    in-out property <string> capture-shortcut;
    in-out property <string> save-directory;
    in property <[string]> ocr-languages;
    in-out property <int> selected-ocr-index: 0;
    in-out property <string> error-message;

    callback browse-requested;
    callback accept-requested;
    callback cancel-requested;

    VerticalLayout {
        spacing: 0px;

        Win32TitleBar {
            height: 36px;
            button-width: 44px;
            hover-button: root.caption-hover;
            background-color: #202328;
            foreground-color: #eef0f2;

            Text {
                text: "Patrick Star 设置";
                color: #f2f3f5;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            padding: 24px;
            spacing: 8px;

            Text { text: "系统设置"; color: #1d2024; font-size: 20px; font-weight: 600; }
            Rectangle { height: 4px; }

            Text { text: "截图热键"; color: #30343a; }
            LineEdit { text <=> root.capture-shortcut; placeholder-text: "Ctrl+Alt+S"; }

            Text { text: "保存路径"; color: #30343a; }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { horizontal-stretch: 1; text <=> root.save-directory; }
                Button { text: "浏览..."; clicked => { root.browse-requested(); } }
            }

            Text { text: "OCR 语言"; color: #30343a; }
            ComboBox { model: root.ocr-languages; current-index <=> root.selected-ocr-index; }

            if root.error-message != "" : Text {
                text: root.error-message;
                color: #b42318;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "取消"; clicked => { root.cancel-requested(); } }
                Button { text: "保存"; primary: true; clicked => { root.accept-requested(); } }
            }
        }
    }
}
